{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Paxbook React Library",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "react-jsx",
    "declaration": true,
    "noEmit": false
  }
}
