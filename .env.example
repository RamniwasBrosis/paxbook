# Copy to apps/api/.env (backend) and apps/admin/.env.local (frontend) — see each app's own .env.example for the split.

# --- Database / Cache (matches docker/docker-compose.yml) ---
DATABASE_URL=postgresql://paxbook:paxbook_dev_password@localhost:5432/paxbook?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_ROOT=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# --- Razorpay (Checkpoint 5, leave blank for now) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- FTD Travel Air API (flight search/booking) ---
FTD_BASE_URL=http://13.200.42.214/book/api/
FTD_AGENT_ID=
FTD_USERNAME=
FTD_PASSWORD=
FTD_API_KEY_TEST=
FTD_API_KEY_LIVE=
FTD_MODE=0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/admin) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
